.page { flex-grow: 1; background-color: rgb(246, 245, 237); color: rgb(42, 57, 48); font-size: 18px; padding: 24px 34px 18px; }
Label { white-space: normal; }
Button { min-height: 42px; border-radius: 10px; border-width: 1px; border-color: rgb(213, 219, 207); background-color: rgb(255, 254, 249); color: rgb(42, 57, 48); padding: 8px 16px; margin: 3px; font-size: 17px; }
Button:hover { background-color: rgb(231, 237, 220); }
Button:focus { border-color: rgb(42, 111, 79); border-width: 2px; }
.primary { background-color: rgb(40, 101, 74); color: white; border-width: 0; padding: 12px 26px; -unity-font-style: bold; }
.primary:hover { background-color: rgb(29, 82, 58); }
.quiet { background-color: transparent; }
.header { flex-direction: row; align-items: center; margin-bottom: 22px; height: 72px; flex-shrink: 0; }
.brand { flex-grow: 1; }
.logo { font-size: 35px; -unity-font-style: bold; letter-spacing: 3px; }
.muted { color: rgb(84, 101, 88); font-size: 15px; }
.small { color: rgb(84, 101, 88); font-size: 14px; margin-top: 7px; }
.week { font-size: 26px; -unity-font-style: bold; margin-right: 28px; }
.metrics { flex-direction: row; margin-bottom: 22px; flex-shrink: 0; }
.metric { flex-grow: 1; flex-basis: 0; background-color: rgb(255, 254, 249); border-radius: 14px; padding: 15px 22px; margin-right: 12px; }
.metric-value { font-size: 30px; -unity-font-style: bold; margin-top: 3px; }
.workspace { flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; }
.team { width: 360px; margin-right: 28px; flex-shrink: 0; }
.team .unity-scroll-view__content-container { padding-right: 4px; }
.backlog { flex-grow: 1; min-width: 0; }
.section-title { font-size: 22px; -unity-font-style: bold; margin-top: 8px; margin-bottom: 7px; }
.employee-card { min-height: 218px; flex-shrink: 0; margin: 14px 0 0; padding: 12px 15px; align-items: stretch; border-width: 2px; border-radius: 16px; -unity-text-align: upper-left; }
.employee-card.selected { border-color: rgb(66, 126, 86); background-color: rgb(239, 244, 227); }
.employee-top { flex-direction: row; align-items: center; margin-bottom: 6px; }
.employee-info { flex-grow: 1; margin-left: 9px; }
.employee-name { font-size: 24px; -unity-font-style: bold; }
.employee-hours { font-size: 18px; margin-top: 5px; margin-bottom: 6px; }
.skills { font-size: 13px; color: rgb(91, 112, 93); margin-top: 10px; }
.tip { margin-top: 18px; padding: 14px; background-color: rgb(234, 235, 221); border-radius: 12px; font-size: 15px; color: rgb(94, 109, 94); }
.tasks { flex-grow: 1; margin-top: 10px; }
.task-card { background-color: rgb(255, 254, 249); border-radius: 14px; padding: 14px 18px; margin: 0 10px 12px 0; }
.task-heading { flex-direction: row; align-items: center; margin-bottom: 8px; }
.task-title { flex-grow: 1; font-size: 21px; -unity-font-style: bold; }
.badge { background-color: rgb(234, 239, 221); color: rgb(68, 103, 72); border-radius: 6px; padding: 3px 10px; font-size: 14px; }
.task-edit { flex-direction: row; align-items: center; margin-top: 7px; }
.assignments { flex-grow: 1; font-size: 15px; }
.hours-input { width: 86px; height: 38px; font-size: 19px; }
.hours-input .unity-text-input { border-radius: 7px; border-color: rgb(188, 200, 182); background-color: rgb(250, 251, 245); padding: 4px 10px; color: rgb(42, 57, 48); }
.unit { margin: 0 10px 0 3px; }
.completed { opacity: 0.65; }
.unity-progress-bar { height: 22px; margin: 3px 0; }
.unity-progress-bar__background { background-color: rgb(228, 232, 221); border-radius: 6px; }
.unity-progress-bar__progress { background-color: rgb(178, 204, 146); border-radius: 6px; }
.unity-progress-bar__title { color: rgb(47, 69, 50); font-size: 13px; }
.footer { flex-direction: row; align-items: center; padding-top: 16px; flex-shrink: 0; }
.status { flex-grow: 1; flex-basis: 0; font-size: 15px; margin-right: 14px; }
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(25, 45, 34, 0.46); align-items: center; justify-content: center; }
.modal { width: 760px; max-height: 90%; padding: 30px; background-color: rgb(255, 254, 247); border-radius: 20px; }
.modal-title { font-size: 28px; -unity-font-style: bold; margin-bottom: 18px; }
.modal-copy { font-size: 18px; margin-bottom: 24px; }
.report { width: 1120px; }
.report ScrollView { flex-shrink: 1; margin-bottom: 16px; }
.report-summary { font-size: 25px; color: rgb(41, 104, 73); -unity-font-style: bold; margin-bottom: 14px; }
.report-metrics { font-size: 21px; }
.report-line { font-size: 18px; margin-top: 14px; padding-top: 5px; }
.hamster { width: 104px; height: 98px; flex-shrink: 0; }
.hamster VisualElement { position: absolute; }
.ear-left, .ear-right { width: 29px; height: 30px; top: 4px; border-radius: 16px; background-color: rgb(216, 166, 105); border-width: 6px; border-color: rgb(240, 204, 151); }
.ear-left { left: 10px; }
.ear-right { right: 10px; }
.face { left: 8px; top: 18px; width: 88px; height: 72px; border-radius: 39px; background-color: rgb(240, 204, 151); }
.gray .face, .gray .ear-left, .gray .ear-right { background-color: rgb(193, 198, 191); border-color: rgb(193, 198, 191); }
.eye-left, .eye-right { top: 43px; width: 7px; height: 9px; border-radius: 5px; background-color: rgb(63, 57, 48); }
.eye-left { left: 32px; }
.eye-right { right: 32px; }
.sleepy .eye-left, .sleepy .eye-right { top: 47px; width: 10px; height: 3px; }
.cheek-left, .cheek-right { top: 57px; width: 19px; height: 12px; border-radius: 9px; background-color: rgb(231, 163, 141); }
.cheek-left { left: 17px; }
.cheek-right { right: 17px; }
.mouth { position: absolute; top: 54px; left: 41px; font-size: 21px; color: rgb(92, 71, 54); }
